PREFIX voc: <https://SEU-USUARIO.github.io/diretorio-web-semantica/ontologia/ontologia.owl#>
PREFIX ex: <https://SEU-USUARIO.github.io/diretorio-web-semantica/recurso/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?projeto ?docenteNome ?discenteNome WHERE { ?docente a voc:Docente ; foaf:name ?docenteNome ; voc:participaDe ?p . ?discente a voc:Discente ; foaf:name ?discenteNome ; voc:participaDe ?p . ?p rdfs:label ?projeto . } ORDER BY ?projeto ?docenteNome
